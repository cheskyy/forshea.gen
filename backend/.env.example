# forshea.gen backend — copy to backend/.env and fill in real values. Placeholders only.

# MongoDB connection
MONGO_URL="mongodb://localhost:27017"
DB_NAME="forshea_gen"

# Comma-separated allowed origins for CORS
CORS_ORIGINS="*"

# Timezone used for "today" (tasks, finance, dashboard)
APP_TZ="Asia/Jakarta"

# AI provider key (server-side only, never exposed to the browser).
# Leave empty to run in MOCK/DEMO mode — results are clearly labeled "DEMO".
EMERGENT_LLM_KEY=""

# Optional: override the image model
# AI_IMAGE_MODEL="gemini-3.1-flash-image-preview"
